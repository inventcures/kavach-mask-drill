{
  "name": "mask-drill",
  "version": "0.1.0",
  "private": true,
  "description": "Phone-first training game for emergency response teams on choosing, fitting, checking and safely removing masks.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-sw.mjs && node scripts/check-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "size": "node scripts/check-size.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
